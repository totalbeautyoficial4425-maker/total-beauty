# Neon Serverless Postgres (Banco Principal em Nuvem)
DATABASE_URL="postgresql://usuario:senha@ep-exemplo.sa-east-1.aws.neon.tech/neondb?sslmode=require"
POSTGRES_URL="postgresql://usuario:senha@ep-exemplo.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob Storage (Armazenamento Resiliente e Backup Automático)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_exemplo"
BLOB_STORE_ID="store_exemplo"
BLOB_WEBHOOK_PUBLIC_KEY="chave_publica_exemplo"
